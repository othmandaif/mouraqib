# Copier en deploy/.env.prod (jamais dans Git) puis remplir.
# Générer un secret : openssl rand -hex 32

DOMAINE=malafipro.ma

# Base de données (noms techniques gardés « mouraqib » : compatibles avec une sauvegarde de la base locale)
POSTGRES_DB=mouraqib_dev
POSTGRES_USER=mouraqib
POSTGRES_PASSWORD=          # openssl rand -hex 24

# Sécurité
JWT_SECRET=                 # openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY= # openssl rand -hex 32  (64 caractères hexadécimaux)

# WhatsApp (Meta) — voir docs/MODELES_WHATSAPP.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=      # jeton PERMANENT d'utilisateur système (pas le jeton de 24 h)
WHATSAPP_VERIFY_TOKEN=      # openssl rand -hex 16 (à recopier dans Meta, webhook)
WHATSAPP_APP_SECRET=
WA_TPL_LANGUE=ar
WA_TPL_CODE=
WA_TPL_DELAI=
WA_TPL_NOUVEAU_DELAI=
WA_TPL_JUGEMENT=
WA_TPL_AUDIENCE=
WA_TPL_EVENEMENT=
WA_TPL_DIGEST=

# E-mails (Resend) : code « mot de passe oublié ». Domaine malafipro.ma vérifié chez Resend.
RESEND_API_KEY=
EMAIL_FROM="MalafiPro <noreply@malafipro.ma>"

# IA
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Vente directe
CONTACT_COMMERCIAL_TEL=+212607167594
CONTACT_COMMERCIAL_EMAIL=contact@malafipro.ma

# Synchronisation mahakim
# Pages ouvertes en même temps par processus (≈ 30 lectures/min par cœur de processeur mesurées)
SCRAPER_CONCURRENCY=1
# Plafond de lectures par minute, COMMUN à tous les processus. Besoin ≈ dossiers × 0,14 / 60
# (10 % chauds toutes les 2 h, 40 % normaux toutes les 6 h, 50 % dormants toutes les 24 h) :
# 20 suffit jusqu'à ~8 000 dossiers ; 60 pour ~25 000. À surveiller dans /admin/sante (« ملفات في انتظار المزامنة »).
SCRAPER_PAR_MINUTE=20
# Pause du robot quand mahakim ne répond plus (échecs d'affilée, minutes de pause)
MAHAKIM_SEUIL_PANNE=5
MAHAKIM_PAUSE_MIN=10
# Alerte « تعذّرت المزامنة » à l'avocat après ce nombre d'heures sans lecture réussie
SYNC_ALERTE_H=48
