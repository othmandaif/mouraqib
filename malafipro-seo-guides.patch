+  justice: { nom: 'وزارة العدل', url: 'https://www.justice.gov.ma', usage: 'معلومات رسمية عن الخدمات الإلكترونية للمحاكم.' },
+  sgg: { nom: 'الأمانة العامة للحكومة (الجريدة الرسمية)', url: 'https://www.sgg.gov.ma', usage: 'النصوص الرسمية للقوانين، ومنها القانون رقم 58.25 (الجريدة الرسمية عدد 7485 بتاريخ 23 فبراير 2026).' },
+  cndp: { nom: 'اللجنة الوطنية لمراقبة حماية المعطيات ذات الطابع الشخصي', url: 'https://www.cndp.ma', usage: 'الهيئة المحدثة بموجب القانون 09.08: التصريح، الإذن المسبق، النقل إلى الخارج.' },
+  dgi: { nom: 'المديرية العامة للضرائب', url: 'https://www.tax.gov.ma', usage: 'المدونة العامة للضرائب وواجبات الفوترة.' },
+  cassation: { nom: 'كتابة الضبط بمحكمة النقض', url: 'https://greffe.courdecassation.ma', usage: 'البحث عن ملف معروض على محكمة النقض.' },
+}
+
+export const GUIDES_AR: Record<GuideId, Guide> = {
+  // ─────────────────────────── 1. تتبع ملف عبر بوابة محاكم ───────────────────────────
+  'suivi-mahakim': {
+    nav: 'تتبع ملف عبر بوابة محاكم',
+    resume: 'المعطيات الواجب جمعها، خطوات البحث، والأخطاء التي توهم بأن الملف غير موجود.',
+    titre: 'تتبع ملف قضائي عبر بوابة محاكم: دليل عملي للمحامي',
+    description: 'خطوات تتبع ملف على بوابة محاكم الرسمية: المعطيات الواجب توفرها، أخطاء شائعة في إدخال رقم الملف، وطريقة تنظيم متابعة عشرات الملفات داخل المكتب.',
